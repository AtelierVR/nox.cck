.notification {
    border-color: var(--info-border);
    background-color: var(--info-background);
    color: var(--info-text);
    border-width: var(--border-width);
    border-radius: var(--boder-radius);
    padding: var(--padding-medium);
    flex-direction: row;
}

.notification.error {
    border-color: var(--error-border);
    background-color: var(--error-background);
    color: var(--error-text);
}

.notification.info {
    border-color: var(--info-border);
    background-color: var(--info-background);
    color: var(--info-text);
}

.notification.warning {
    border-color: var(--warning-border);
    background-color: var(--warning-background);
    color: var(--warning-text);
}

.notification.success {
    border-color: var(--success-border);
    background-color: var(--success-background);
    color: var(--success-text);
}

.notification.error .icon {
    background-image: var(--error-icon-texture);
    -unity-background-image-tint-color: var(--error-icon-color);
}

.notification.info .icon {
    background-image: var(--info-icon-texture);
    -unity-background-image-tint-color: var(--info-icon-color);
}

.notification.warning .icon {
    background-image: var(--warning-icon-texture);
    -unity-background-image-tint-color: var(--warning-icon-color);
}

.notification.success .icon {
    background-image: var(--success-icon-texture);
    -unity-background-image-tint-color: var(--success-icon-color);
}

/* Icon of Nox.CCK.Editor.NotificationElement: it carries its own class so the element keeps its glyph
   and its size whatever stylesheets the panel loads (the rules above come from the loader sheet). */
.notification-icon {
    width: 24px;
    height: 24px;
    margin-right: 8px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* Structure of Nox.CCK.Editor.NotificationElement: the message is what sizes the box, so it wraps and
   shrinks while the icon and the actions keep their size. The body is centred, so a one-line message
   stays in the middle when a button makes the box taller. */
.notification-body {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    justify-content: center;
}

.notification-message {
    white-space: normal;
    flex-wrap: wrap;
    flex-shrink: 1;
    min-width: 0;
}

/* The loader sheet also styles `.notification .unity-label` with `flex-grow: 1` (and the sheets can be loaded
   in either order): inside the column body that makes a short message grow and stop being centred. The extra
   class wins whatever the order, and the message keeps its own height so the body (justify-content: center)
   centres it — its width still stretches, so a long message wraps from the left. */
.notification .notification-body .notification-message {
    -unity-text-align: middle-left;
    white-space: normal;
    flex-wrap: wrap;
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
}

.notification-actions {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin-top: 4px;
}

.notification.error .notification-icon {
    background-image: var(--error-icon-texture);
    -unity-background-image-tint-color: var(--error-icon-color);
}

.notification.info .notification-icon {
    background-image: var(--info-icon-texture);
    -unity-background-image-tint-color: var(--info-icon-color);
}

.notification.warning .notification-icon {
    background-image: var(--warning-icon-texture);
    -unity-background-image-tint-color: var(--warning-icon-color);
}

.notification.success .notification-icon {
    background-image: var(--success-icon-texture);
    -unity-background-image-tint-color: var(--success-icon-color);
}

/* Barre récapitulative des notifications (Publisher) : une icône + un nombre par type,
   items centrés horizontalement. Les items à zéro sont masqués côté code. */
.notification-summary {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    padding-top: 8px;
    padding-bottom: 8px;
}

.notification-summary > .summary-item {
    flex-direction: row;
    align-items: center;
    margin-left: 8px;
    margin-right: 8px;
}

.notification-summary > .summary-item > .icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.notification-summary > .summary-item.error > .icon {
    background-image: resource('icons/error');
    -unity-background-image-tint-color: rgb(200, 50, 50);
}

.notification-summary > .summary-item.warning > .icon {
    background-image: resource('icons/warning');
    -unity-background-image-tint-color: rgb(200, 151, 10);
}

.notification-summary > .summary-item.info > .icon {
    background-image: resource('icons/info');
    -unity-background-image-tint-color: rgb(100, 160, 240);
}

.notification-summary > .summary-item.success > .icon {
    background-image: resource('icons/success');
    -unity-background-image-tint-color: rgb(58, 171, 58);
}