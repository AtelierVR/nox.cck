/*@import url("unity-theme://default");*/

@import "variables.uss";
@import "height.uss";
@import "width.uss";
@import "text.uss";
@import "padding.uss";
@import "margin.uss";
@import "gap.uss";
@import "flex.uss";
@import "justify.uss";
@import "align.uss";
@import "position.uss";
@import "rounded.uss";
@import "opacity.uss";
@import "background.uss";
@import "border.uss";
@import "display.uss";

@import "large.uss";
@import "notification.uss";
@import "badge.uss";
@import "list.uss";
@import "section.uss";
@import "value.uss";

.transition {
    transition-duration: 0.1s;
}

.readonly .unity-object-field__selector {
    display: none;
}

/* Read-only value (a field built with `isReadOnly`): the box is sunk into the panel and the text is
   dimmer, so it reads as "you cannot type here" next to the editable rows around it. */
.readonly .unity-base-text-field__input,
.readonly .unity-text-field__input {
    background-color: rgba(0, 0, 0, 0.25);
    border-color: rgba(255, 255, 255, 0.06);
    color: rgba(210, 210, 210, 0.7);
}

/* Icon of an inspector header (see InspectorEditor): a small square next to the title. */
.header-icon {
    width: 16px;
    height: 16px;
    margin-right: 6px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* Foldout whose content is aligned with the panel, instead of being indented under its toggle. */
.foldout-flush > .unity-foldout__content {
    margin-left: 0;
}

.margin {
    margin-top: 1px;
    margin-right: 3px;
    margin-bottom: 4px;
    margin-left: 3px;
}

.margin-x {
    margin-right: 3px;
    margin-left: 3px;
}

.margin-y {
    margin-top: 1px;
    margin-bottom: 4px;
}

.scroll-full > * > * > .unity-scroll-view__content-container {
    width: 100%;
    min-height: 100%;
}

.unity-base-text-field__input--multiline {
    min-height: 96px;
}
